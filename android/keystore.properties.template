# Copy this file to android/keystore.properties and fill in your values
# This file should NOT be committed to version control (add to .gitignore)

# Path to your keystore file (relative to android/ directory or absolute path)
storeFile=../keystore/wealthlens-release-key.jks

# Keystore password
storePassword=YOUR_KEYSTORE_PASSWORD

# Key alias
keyAlias=wealthlens-release

# Key password (often same as keystore password)
keyPassword=YOUR_KEY_PASSWORD
