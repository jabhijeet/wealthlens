<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive app data from cloud backup -->
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="database" path="wealthlens.db"/>
        <exclude domain="external" path="wealthlens/"/>
        <exclude domain="file" path="keystore/"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive app data from device transfer -->
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml"/>
        <exclude domain="database" path="wealthlens.db"/>
        <exclude domain="external" path="wealthlens/"/>
        <exclude domain="file" path="keystore/"/>
    </device-transfer>
</data-extraction-rules>
